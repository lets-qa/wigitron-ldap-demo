# Copy to .env and adjust per deployment. docker-compose reads this automatically.
# The container ALWAYS listens on 389/636 internally; these only remap the
# published HOST ports. Defaults reproduce a stock local run.

# Stock local DC (default):
LDAP_PORT=389
LDAPS_PORT=636

# International DC on ci.bcasqa.com publishes remapped ports instead:
#   LDAP_PORT=1389
#   LDAPS_PORT=1636

# test_binds.sh also honors LDAP_HOST / LDAPS_PORT to aim at a remote DC:
#   LDAP_HOST=ci.bcasqa.com
#   LDAPS_PORT=1636
